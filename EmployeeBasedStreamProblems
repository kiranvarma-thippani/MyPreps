// If you want to return only highest salary of the employee per department.
// If you want to provide the final transformation for collected list. Then you can make use of this .Collectors.collectingAndThen
Map<String, Object> mapGroup= employeeList.stream()
	     .collect(Collectors.groupingBy(Employee::getDeptName,
	    Collectors.collectingAndThen(Collectors.maxBy(Comparator.comparingLong(Employee::getSalary)), 
	    				 e->e.get().getSalary())));
	    System.out.println(mapGroup);

