//Program for grouping the employees with respect to the Department and max salary for each .
 Map<String, Optional<Employee>> mapGroup= employeeList.stream()
	     .collect(Collectors.groupingBy(Employee::getDeptName,
	    		 Collectors.maxBy(Comparator.comparingDouble(Employee::getSalary)))); // If you use the online compiler, just import the java.util.*, java.util.stream.*
