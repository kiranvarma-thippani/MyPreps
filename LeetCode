class Solution {
    public int maxSubArray(int[] nums) {
    int sum=0;
    int max_sum=Integer.MIN_VALUE;
    int start=0;
     int end=0;
    for(int i=0;i<nums.length;i++){
       if(sum==0){
          start=i;
        }
        sum+=nums[i];
        if(sum>Math.max(max_sum,sum){
           end=i;
           max_sum=sum;
            }
       if(sum<0) sum=0;
       }
        return max_sum;
    }
}













