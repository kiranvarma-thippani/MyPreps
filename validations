Custom Validation Annotations:


@Target({ElementType.FIELD,ElementType.PARAMETER})
@Retention(RetentionPolicy.RUNTIME)
@Documented
@Constraint(validatedBy = UserTypeResolver.class)
public @interface ValidateUserType {
	public String message() default "Please specify whether u are a admin or user";
	Class<?>[] groups() default { };

	Class<? extends Payload>[] payload() default { };

}


public class UserTypeResolver implements ConstraintValidator<ValidateUserType, String> {

	@Override
	public boolean isValid(String value, ConstraintValidatorContext context) {
		// TODO Auto-generated method stub
		List<String> list=Arrays.asList("Admin","User");
         return list.contains(value);

	}

}

